{
  "name": "benchmark-site",
  "version": "1.0.0",
  "private": true,
  "description": "Static website for the benchmark platform, generated from the published dataset in src/data/.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
