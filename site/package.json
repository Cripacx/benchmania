    "test:watch": "vitest",
    "check": "astro check",
    "verify": "node scripts/verify.ts",
    "ci": "npm run check && npm test && npm run build && npm run verify"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.6",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "astro": "7.4.12",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
