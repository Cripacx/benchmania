---
import Icon from './Icon.astro';
---

<button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Theme: system" title="Theme: system">
  <Icon name="monitor" size={18} class="t-system" />
  <Icon name="sun" size={18} class="t-light" />
  <Icon name="moon" size={18} class="t-dark" />
</button>

<script>
  const ORDER = ['system', 'light', 'dark'] as const;
  type Mode = (typeof ORDER)[number];

  function read(): Mode {
    try {
      const v = localStorage.getItem('theme');
      return v === 'light' || v === 'dark' ? v : 'system';
    } catch {
      return 'system';
    }
  }

  function apply(mode: Mode) {
    const root = document.documentElement;
    if (mode === 'system') root.removeAttribute('data-theme');
    else root.setAttribute('data-theme', mode);
    try {
      if (mode === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', mode);
    } catch {
      // storage unavailable: the choice lasts for this page view only
    }
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      const next = ORDER[(ORDER.indexOf(mode) + 1) % ORDER.length];
      btn.dataset.mode = mode;
      const label = `Theme: ${mode} (switch to ${next})`;
      btn.setAttribute('aria-label', label);
      btn.title = label;
    }
  }

  apply(read());
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    btn.addEventListener('click', () => {
      const current = read();
      apply(ORDER[(ORDER.indexOf(current) + 1) % ORDER.length] ?? 'system');
    });
  }
</script>

<style>
  .theme-toggle :global(svg) {
    display: none;
  }
  .theme-toggle:not([data-mode]) :global(.t-system),
  .theme-toggle[data-mode='system'] :global(.t-system),
  .theme-toggle[data-mode='light'] :global(.t-light),
  .theme-toggle[data-mode='dark'] :global(.t-dark) {
    display: block;
  }
</style>
