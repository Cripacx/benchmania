---
/** Generic mark: three ranked bars on the brand gradient. The project name next to it comes from the dataset. */
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<span class="logo-mark" style={`--logo-size: ${size}px`} aria-hidden="true">
  <svg width={size} height={size} viewBox="0 0 24 24" focusable="false">
    <rect class="b1" x="6" y="6.5" width="12" height="2.6" rx="1.3"></rect>
    <rect class="b2" x="6" y="10.7" width="9" height="2.6" rx="1.3" opacity="0.85"></rect>
    <rect class="b3" x="6" y="14.9" width="5.5" height="2.6" rx="1.3" opacity="0.7"></rect>
  </svg>
</span>

<style>
  .logo-mark {
    display: inline-grid;
    flex: none;
    width: var(--logo-size);
    height: var(--logo-size);
    border-radius: calc(var(--logo-size) * 0.27);
    background: var(--brand-grad);
    box-shadow: 0 2px 8px -3px var(--brand-2);
  }
  rect {
    fill: var(--on-brand);
    transform-box: fill-box;
    transform-origin: left center;
    transition: transform 260ms var(--ease);
  }
  /* The bars race a little when the brand link is hovered. */
  :global(a:hover) > .logo-mark .b2 {
    transform: scaleX(1.25);
  }
  :global(a:hover) > .logo-mark .b3 {
    transform: scaleX(1.6);
  }
</style>
