---
/** Generic mark: three ranked bars. The project name next to it comes from the dataset. */
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <rect x="1" y="1" width="22" height="22" rx="6.5" fill="currentColor"></rect>
  <rect x="6" y="6.5" width="12" height="2.6" rx="1.3" fill="var(--bg)"></rect>
  <rect x="6" y="10.7" width="9" height="2.6" rx="1.3" fill="var(--bg)" opacity="0.82"></rect>
  <rect x="6" y="14.9" width="5.5" height="2.6" rx="1.3" fill="var(--bg)" opacity="0.64"></rect>
</svg>
