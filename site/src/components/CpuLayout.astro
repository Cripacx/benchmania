---
/**
 * Logical CPUs of the machine colored by the role the run's layout assigns them (service, environment, load
 * generator), and those it assigns to no role. Only facts from the run's layout are drawn; the physical core pairing
 * is not inferred. What a role is in a domain (a database, nothing at all: an empty name) comes from the domain
 * (`methodology.roles`); without it the engine's names. The layout is CPU affinity (cpusets): it decides where the
 * benchmark's own work runs, not what else runs on those CPUs, and the note says so.
 */
import { isVirtualMachine } from '../lib/model';
import type { CpuLayout, Machine } from '../lib/types';

interface Props {
  layout: CpuLayout | undefined;
  machine: Machine | undefined;
  /** The domain's names for the roles, e.g. { environment: 'PostgreSQL' }. */
  roleNames?: Record<string, string>;
  compact?: boolean;
}

const { layout, machine, roleNames = {}, compact = false } = Astro.props;
// A role the domain names with an empty string is not used there: the benchmark assigns its CPUs to nothing.
const unused = (id: string) => roleNames[id] === '';
const roles = [
  { id: 'service', label: roleNames.service || 'Implementation under test', cpus: layout?.service ?? [] },
  { id: 'environment', label: roleNames.environment || 'Environment', cpus: unused('environment') ? [] : (layout?.environment ?? []) },
  // The runner is pinned to the load generator's CPUs in every domain, so this role is never unassigned.
  { id: 'loadgen', label: roleNames.loadgen || (unused('loadgen') ? 'Benchmark runner' : 'Load generator'), cpus: layout?.loadgen ?? [] },
  { id: 'free', label: 'Not assigned (role unused here)', cpus: unused('environment') ? (layout?.environment ?? []) : [] },
  { id: 'idle', label: 'Not assigned (SMT siblings)', cpus: layout?.idle ?? [] },
];
const assigned = new Map<number, string>();
for (const r of roles) for (const c of r.cpus) if (!assigned.has(c)) assigned.set(c, r.id);
const maxCpu = Math.max(-1, ...assigned.keys());
const logical = Math.max(machine?.cpu?.logical ?? 0, maxCpu + 1);
const cells = Array.from({ length: logical }, (_, i) => ({ cpu: i, role: assigned.get(i) ?? 'none' }));
const hasLayout = assigned.size > 0;
const roleLabel = (id: string) => roles.find((r) => r.id === id)?.label ?? 'Not assigned by the benchmark';
const vm = isVirtualMachine(machine);
// What this layout does about SMT, from the layout itself: `idle` is filled only when every service CPU got a
// physical core of its own; the planner's fallbacks for small machines and manual layouts leave it empty.
const smtNote =
  (layout?.idle?.length ?? 0) > 0
    ? 'SMT is on. The implementation under test gets one logical CPU per physical core, and the benchmark assigns the SMT siblings of those cores to no role.'
    : layout?.smt === true
      ? 'SMT is on, and this layout leaves no SMT sibling of the service CPUs unassigned.'
      : layout?.smt === false
        ? `SMT is off${vm ? ' as far as the virtual machine reports it' : ' on this machine'}.`
        : null;
const limitsNote = `Pinning (CPU affinity) decides where the benchmark's containers and processes run; it does not keep other work on the ${vm ? 'virtual machine' : 'machine'} off these CPUs${vm ? ', and they are virtual CPUs whose placement on physical cores is up to the hypervisor' : ''}.`;
---

{
  hasLayout ? (
    <figure class={`cpu-layout ${compact ? 'compact' : ''}`}>
      <ol class="cpu-cells" aria-label="Logical CPUs by role">
        {cells.map((c) => (
          <li class={`cpu-cell role-${c.role}`} title={`CPU ${c.cpu}: ${roleLabel(c.role)}`}>
            <span class="visually-hidden">
              CPU {c.cpu}: {roleLabel(c.role)}
            </span>
            <span aria-hidden="true">{c.cpu}</span>
          </li>
        ))}
      </ol>
      <figcaption>
        <ul class="cpu-legend">
          {roles
            .filter((r) => r.cpus.length > 0)
            .map((r) => (
              <li>
                <span class={`dot role-${r.id}`} />
                {r.label}
                <span class="muted num">{r.cpus.join(', ')}</span>
              </li>
            ))}
        </ul>
        <p class="muted cpu-note">
          {smtNote && `${smtNote} `}
          {limitsNote}
        </p>
      </figcaption>
    </figure>
  ) : (
    <p class="muted">This run does not record a CPU layout.</p>
  )
}

<style>
  .cpu-layout {
    margin: 0;
  }
  .cpu-cells {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(38px, 1fr));
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 560px;
  }
  .compact .cpu-cells {
    grid-template-columns: repeat(auto-fill, minmax(26px, 1fr));
    gap: 3px;
  }
  .cpu-cell {
    --role: var(--role-idle);
    display: grid;
    place-items: center;
    height: 34px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    background: color-mix(in srgb, var(--role) 24%, var(--surface));
    box-shadow: inset 0 -3px 0 var(--role);
  }
  .compact .cpu-cell {
    height: 26px;
    border-radius: 5px;
    font-size: 0.6875rem;
  }
  .role-service {
    --role: var(--series-1);
  }
  .role-environment {
    --role: var(--series-2);
  }
  .role-loadgen {
    --role: var(--series-3);
  }
  .role-idle {
    --role: var(--role-idle);
    color: var(--text-2);
  }
  .role-none,
  .role-free {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--border-strong);
    color: var(--muted);
  }
  .dot.role-service,
  .dot.role-environment,
  .dot.role-loadgen,
  .dot.role-idle {
    background: var(--role);
  }
  .dot.role-free {
    background: transparent;
  }
  figcaption {
    margin-top: 12px;
  }
  .cpu-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--text-2);
  }
  .cpu-legend li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .cpu-legend .muted {
    font-size: 0.75rem;
  }
  .cpu-note {
    margin-top: 8px;
    font-size: 0.8125rem;
  }
</style>
