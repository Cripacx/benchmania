---
import BaseLayout from '../layouts/BaseLayout.astro';
import InstallChooser from '../components/InstallChooser.astro';
import Icon from '../components/Icon.astro';
import CpuLayout from '../components/CpuLayout.astro';
import DomainBoard from '../components/DomainBoard.astro';
import DomainSummary from '../components/DomainSummary.astro';
import { allDomains, getProject } from '../lib/dataset';
import { formatNumber, plural } from '../lib/format';
import {
  communityRunsNote,
  communityStatus,
  defaultRun,
  domainStatus,
  installCommand,
  measuredScenarios,
  metricIdsInRun,
  repoPage,
  repoUrl,
} from '../lib/model';
import { href, routes } from '../lib/paths';

const project = getProject();
const domains = allDomains();
// Stable domains first, then experimental ones; every domain gets a summary at the top and, with a run, a board.
const summaries = domains
  .map((domain) => ({ domain, run: defaultRun(domain) }))
  .sort((a, b) => Number(a.domain.domain.status !== 'stable') - Number(b.domain.domain.status !== 'stable'));
const boards = summaries.filter((b): b is { domain: typeof b.domain; run: NonNullable<typeof b.run> } => !!b.run);
// The CPU layout illustrating "Pinned CPUs": the default run of the first domain with one.
const layoutDomain = boards[0]?.domain;
const layoutRun = boards[0]?.run;

const community = communityStatus(domains);
const totalImpls = community.implementations;
const totalLanguages = new Set(domains.flatMap((d) => d.implementations.map((i) => i.language))).size;
const totalRuns = community.runs;
const install = installCommand(project);

const ways = [
  {
    icon: 'server' as const,
    title: 'Measure on your hardware',
    text: 'Run the suite on a Linux machine with Docker and open a pull request that adds the result bundle.',
    cta: 'Submit a run',
    href: href(routes.contribute('submit')),
  },
  {
    icon: 'plus' as const,
    title: 'Add an implementation',
    text: 'A language, framework or variant: a directory with an impl.toml, a Dockerfile and the source.',
    cta: 'Add an implementation',
    href: href(routes.contribute('implementation')),
  },
  {
    icon: 'layers' as const,
    title: 'Add a domain',
    text: 'A new area such as databases or compute. Domains are discovered automatically and get their own pages.',
    cta: 'Add a domain',
    href: href(routes.contribute('domain')),
  },
];

const headlineWords = project.tagline.split(' ');

// Each domain's container limits, from its manifest: "2 CPUs and 1 GiB of memory (Domain title)".
const limits = domains.flatMap((d) => {
  const service = (d.domain.service ?? {}) as Record<string, unknown>;
  const cpus = typeof service.cpus === 'number' ? service.cpus : null;
  const memory = typeof service.memory === 'string' ? service.memory.replace(/^(\d+)g$/i, '$1 GiB').replace(/^(\d+)m$/i, '$1 MiB') : null;
  return cpus && memory ? [`${plural(cpus, 'CPU')} and ${memory} of memory${domains.length > 1 ? ` (${d.domain.title})` : ''}`] : [];
});
const machine = layoutDomain && layoutRun ? layoutDomain.machines[layoutRun.machine] : undefined;
---

<BaseLayout>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-lines" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-text">
      <p class="hero-eyebrow">
        <span class="pulse" aria-hidden="true"></span>
        Open source · {plural(totalImpls, 'implementation')} · {plural(totalLanguages, 'language')} · {
          plural(totalRuns, 'published run')
        }
      </p>
      <h1>
        {headlineWords.map((word, i) => (
          <>
            {i > 0 && ' '}
            <span class={i === headlineWords.length - 1 && i > 0 ? 'word brand-text' : 'word'}>{word}</span>
          </>
        ))}
      </h1>
      <p class="lead hero-lead">{project.description}</p>
      </div>
      {
        summaries.length > 0 && (
          <div class="hero-domains" id="domains">
            <p class="hd-label">
              {summaries.length === 1 ? 'The domain measured here' : `${plural(summaries.length, 'domain')}, each measured on its own`}
            </p>
            <ul class="hd-list">
              {summaries.map((d) => (
                <li>
                  <DomainSummary domain={d.domain} run={d.run} />
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div class="hero-cta">
        <a class="btn btn-primary" href={href(routes.contribute())}>
          <Icon name="users" /> Contribute your results
        </a>
        <a class="btn btn-secondary" href={href(routes.methodology())}>How we measure</a>
      </div>
    </div>
  </section>

{boards.map((b) => <DomainBoard domain={b.domain} run={b.run} />)}

  <section class="section" id="community" aria-labelledby="community-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow"><Icon name="users" /> Community</p>
          <h2 id="community-title">Run by its contributors</h2>
          <p>
            Implementations, domains and measurements all arrive as pull requests. Run the suite on your own machine and
            your results are published next to everyone else's, with the hardware they were measured on.
          </p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-secondary" href={repoUrl(project, 'CONTRIBUTING.md', 'blob')}>
            <Icon name="book" /> Contributing guide
          </a>
          <a class="btn btn-ghost" href={repoPage(project, 'discussions')}>Ideas and questions</a>
        </div>
      </div>
      {
        install && (
          <div class="card install" data-reveal>
            <div class="install-text">
              <h3>
                <Icon name="server" size={18} /> Measure on your own machine
              </h3>
              <p>
                One line installs the <code>{project.slug}</code> command: a git checkout and a small launcher, no root or
                administrator rights. Or let your coding agent do it. Measuring needs Linux with Docker;
                <code>{`${project.slug} doctor`}</code> checks the machine.
              </p>
            </div>
            <InstallChooser project={project} id="home-install" />
          </div>
        )
      }
      <ul class="grid grid-3 ways" aria-label="Ways to take part" data-reveal="stagger">
        {
          ways.map((w) => (
            <li>
              <a class="card card-pad card-link entry" href={w.href}>
                <Icon name={w.icon} size={18} />
                <h3>{w.title}</h3>
                <p>{w.text}</p>
                <span class="entry-cta">
                  {w.cta} <Icon name="arrowRight" class="arrow" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="card community-status" data-reveal>
        <dl class="status-counts">
          <div>
            <dt>Published runs</dt>
            <dd>{formatNumber(community.runs, 0)}</dd>
          </div>
          <div>
            <dt>Machines</dt>
            <dd>{formatNumber(community.machines, 0)}</dd>
          </div>
          <div>
            <dt>Reference runs</dt>
            <dd>{formatNumber(community.reference, 0)}</dd>
          </div>
          <div>
            <dt>Community runs</dt>
            <dd>{formatNumber(community.community, 0)}</dd>
          </div>
        </dl>
        <div class="status-text">
          <p>
            <strong>{communityRunsNote(community)}</strong> Reference runs are measured by the maintainers; every other
            merged run is labelled community.
          </p>
          <a class="btn btn-primary btn-sm" href={href(routes.contribute('submit'))}>
            Submit a run <Icon name="arrowRight" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow"><Icon name="flask" /> Methodology</p>
          <h2 id="how-title">Measured the same way, for everyone</h2>
          <p>
            Numbers are only worth comparing when the conditions are the same. Within a run, implementations are measured
            on the same machine, with the same workload and inputs for each scenario, and summarized using the same
            statistics.
          </p>
        </div>
        <a class="btn btn-secondary" href={href(routes.methodology())}>Read the methodology <Icon name="arrowRight" /></a>
      </div>
      <div class="grid grid-4 how" data-reveal="stagger">
        <article class="card card-pad">
          <span class="how-icon"><Icon name="memory" size={18} /></span>
          <h3>Same limits</h3>
          <p>
            Within a domain, every implementation runs alone in its own container with the same limits{limits.length ? `: ${limits.join('; ')}.` : '.'}
          </p>
        </article>
        <article class="card card-pad">
          <span class="how-icon"><Icon name="cpu" size={18} /></span>
          <h3>Pinned CPUs</h3>
          <p>
            The implementation under test is pinned to the CPUs the run's layout assigns it, one per physical core where the
            machine has enough. Whatever else a domain runs, such as a database container or the load generator's processes,
            is pinned to the CPUs of its own role, apart from the implementation's when the machine has enough CPUs.
            Pinning does not keep other work on the machine, or a hypervisor, off those CPUs.
          </p>
          {layoutDomain && layoutRun && (
            <div class="how-cpu">
              <CpuLayout layout={layoutRun.layout} machine={machine} roleNames={layoutDomain.domain.methodology?.roles} compact />
            </div>
          )}
        </article>
        <article class="card card-pad">
          <span class="how-icon"><Icon name="layers" size={18} /></span>
          <h3>Repeated and robust</h3>
          <p>
            Several passes in rotating order. Results are medians with a 95 % bootstrap confidence interval; outliers are
            flagged, never silently removed.
          </p>
        </article>
        <article class="card card-pad">
          <span class="how-icon"><Icon name="checkCircle" size={18} /></span>
          <h3>Verified work</h3>
          <p>
            Every implementation must pass its domain's correctness checks before it is measured, and what it does while it
            is measured is checked as well. <a href={`${href(routes.methodology())}#quality`}>Checks per domain</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="explore-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow"><Icon name="grid" /> Go deeper</p>
          <h2 id="explore-title">Everything behind the headline</h2>
          <p>Each leaderboard shows a domain's headline numbers. The dataset has many more, and all of it is open.</p>
        </div>
      </div>
      <div class="grid grid-4" data-reveal="stagger">
        {
          domains.map((d) => {
            // Counts of what the explorer shows: the default run, not everything the registry defines.
            const r = defaultRun(d);
            const scenarios = r ? measuredScenarios(d, r).length : d.scenarios.length;
            const metrics = r ? metricIdsInRun(r).size : Object.keys(d.metrics).length;
            return (
            <a class="card card-pad card-link entry" href={href(routes.domain(d.domain.id))}>
              <Icon name="barsH" size={18} />
              <h3>{d.domain.title}</h3>
              <p>
                {domainStatus(d.domain.status) ? `${domainStatus(d.domain.status)?.label}. ` : ''}
                {plural(d.implementations.length, 'implementation')}, {plural(scenarios, 'scenario')} and{' '}
                {plural(metrics, 'metric')} with confidence intervals, and a side-by-side comparison.
              </p>
              <span class="entry-cta">
                Open explorer <Icon name="arrowRight" class="arrow" />
              </span>
            </a>
            );
          })
        }
        <a class="card card-pad card-link entry" href={href(routes.machines())}>
          <Icon name="cpu" size={18} />
          <h3>Machines</h3>
          <p>Every run records the hardware fingerprint, kernel, Docker version and CPU layout it was measured on.</p>
          <span class="entry-cta">See machines <Icon name="arrowRight" class="arrow" /></span>
        </a>
        <a class="card card-pad card-link entry" href={href(routes.data())}>
          <Icon name="download" size={18} />
          <h3>Open data</h3>
          <p>
            Download the dataset as JSON{project.data_license ? ` under ${project.data_license}` : ''}, or the raw per-pass
            result bundles.
          </p>
          <span class="entry-cta">Get the data <Icon name="arrowRight" class="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--grid) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 70% 80% at 30% 0%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 30% 0%, #000 30%, transparent 75%);
    opacity: 0.9;
  }
  /* Brand glow and speed lines: they settle once after load (5 s, transform only) and then rest. The resting
     position is the base style, so nothing stays in effect afterwards and nothing moves without .anim. */
  .hero-lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 60% 85% at 76% 42%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 85% at 76% 42%, #000 20%, transparent 75%);
  }
  .hero-lines::before {
    content: '';
    position: absolute;
    inset: -30% -10% -10% 30%;
    background:
      radial-gradient(closest-side at 30% 45%, var(--brand-glow-1), transparent 72%),
      radial-gradient(closest-side at 62% 52%, var(--brand-glow-2), transparent 72%),
      radial-gradient(closest-side at 78% 28%, var(--brand-glow-3), transparent 70%);
    transform: translate3d(-9%, 5%, 0) scale(1.1);
  }
  .hero-lines::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: -1040px;
    background-image:
      linear-gradient(90deg, transparent 58%, var(--speed-line) 92%, transparent),
      linear-gradient(90deg, transparent 72%, var(--speed-line) 96%, transparent),
      linear-gradient(90deg, transparent 50%, var(--speed-line) 88%, transparent),
      linear-gradient(90deg, transparent 66%, var(--speed-line) 94%, transparent),
      linear-gradient(90deg, transparent 60%, var(--speed-line) 90%, transparent);
    background-repeat: repeat-x;
    background-size:
      520px 1px,
      1040px 1px,
      260px 1px,
      1040px 2px,
      520px 1px;
    background-position:
      0 18%,
      300px 33%,
      90px 52%,
      700px 67%,
      410px 84%;
    /* Every period divides 1040 px, so this shows the same lines as 0 does. */
    transform: translate3d(-1040px, 0, 0);
  }
  :global(.anim) .hero-lines::before {
    animation: glow-drift 5s var(--ease-out) backwards;
  }
  :global(.anim) .hero-lines::after {
    animation: speed-lines 4.5s cubic-bezier(0.25, 0.6, 0.3, 1) backwards;
  }
  @keyframes glow-drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
  }
  @keyframes speed-lines {
    from {
      transform: translate3d(0, 0, 0);
    }
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    align-items: start;
    padding-block: clamp(40px, 6vw, 72px) clamp(36px, 5vw, 56px);
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 5px 12px 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    color: var(--text-2);
    font-size: 0.8125rem;
    font-weight: 500;
    box-shadow: var(--shadow-sm);
  }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--good-icon);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--good-icon) 22%, transparent);
  }
  .hero h1 {
    margin-top: 22px;
    max-width: 24ch;
    text-wrap: balance;
    font-size: clamp(2.375rem, 1.6rem + 2.9vw, 3.75rem);
  }
  .hero h1 .word {
    white-space: nowrap; /* never break inside a hyphenated word */
  }
  .hero-lead {
    margin-top: 20px;
  }
  .hero-domains {
    margin-top: 28px;
  }
  .hd-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
  }
  .hd-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 12px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .how p {
    margin-top: 6px;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .how-icon {
    display: inline-grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-bottom: 14px;
    border-radius: 9px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text);
  }
  .how-cpu {
    margin-top: 14px;
  }
  .how-cpu :global(.cpu-legend) {
    font-size: 0.71875rem;
    gap: 4px 12px;
  }
  .how-cpu :global(.cpu-legend .muted),
  .how-cpu :global(.cpu-note) {
    display: none;
  }

  .entry {
    display: flex !important;
    flex-direction: column;
  }
  .entry > :global(svg:first-child) {
    color: var(--muted);
  }
  .entry h3 {
    margin-top: 14px;
  }
  .entry p {
    margin-top: 6px;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .entry-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 16px;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .install {
    display: grid;
    gap: 16px;
    margin-bottom: 16px;
    padding: clamp(18px, 2.4vw, 28px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
  }
  @media (min-width: 900px) {
    .install {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: 40px;
      align-items: center;
    }
  }
  .install-text {
    min-width: 0;
  }
  .install h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.25rem;
  }
  .install-text p {
    margin-top: 8px;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .ways {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ways li,
  .ways .entry {
    height: 100%;
  }
  .community-status {
    display: grid;
    gap: 16px 32px;
    margin-top: 16px;
    padding: 18px clamp(16px, 2.4vw, 24px);
    background:
      radial-gradient(120% 160% at 100% 0%, var(--accent-soft), transparent 55%),
      var(--surface);
  }
  @media (min-width: 900px) {
    .community-status {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
    }
  }
  .status-counts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, auto));
    gap: 8px 28px;
    margin: 0;
  }
  @media (max-width: 559px) {
    .status-counts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .status-counts dt {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .status-counts dd {
    margin: 2px 0 0;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }
  .status-text {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
  }
  .status-text p {
    flex: 1 1 32ch;
    max-width: 60ch;
    font-size: 0.9375rem;
    color: var(--text-2);
  }
  .status-text strong {
    color: var(--text);
    font-weight: 600;
  }
</style>
