---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CodeBlock from '../components/CodeBlock.astro';
import InstallChooser from '../components/InstallChooser.astro';
import Icon from '../components/Icon.astro';
import { allDomains, getProject } from '../lib/dataset';
import { communityRunsNote, communityStatus, installCommand, repoPage, repoUrl } from '../lib/model';
import { plural } from '../lib/format';
import { href, routes } from '../lib/paths';

const project = getProject();
// Measuring uses the installed command; adding to the suite edits a checkout and uses its wrapper script.
const cmd = project.slug;
const cli = `./${project.slug}`;
const domains = allDomains();
const community = communityStatus(domains);
const domainId = domains[0]?.domain.id ?? '<domain>';
const sampleImpl = domains[0]?.implementations[0]?.id ?? '<existing-id>';
const guide = (file: string) => repoUrl(project, `docs/guides/${file}`, 'blob');
const issues = repoPage(project, 'issues');
const discussions = repoPage(project, 'discussions');
const repoDir = project.repository.replace(/\/+$/, '').split('/').pop() || project.slug;

const cloneLine = `git clone ${project.repository} && cd ${repoDir}`;
const install = installCommand(project);
const run = install ? cmd : cli;

// With the installer, its line is in the install chooser next to these commands; without, they start with a clone.
const submitCode = [
  ...(install ? [] : [cloneLine]),
  `${run} doctor`,
  `${run} check ${domainId}`,
  `${run} run ${domainId} --label "My workstation"`,
  `${run} validate`,
].join('\n');

const paths = [
  {
    id: 'implementation',
    icon: 'plus' as const,
    title: 'Add an implementation',
    text: 'A new language, framework or variant. Implementations are a directory with an impl.toml, a Dockerfile and the source.',
    guide: guide('adding-an-implementation.md'),
    code: `${cloneLine}\n${cli} scaffold ${domainId} my-framework --from ${sampleImpl}\n${cli} validate\n${cli} check ${domainId} --impl my-framework`,
  },
  {
    id: 'scenario',
    icon: 'activity' as const,
    title: 'Add a scenario',
    text: 'A new workload is one TOML file. Its kind must be one the domain harness understands; database work per request is declared and verified.',
    guide: guide('adding-a-scenario.md'),
    code: `# domains/${domainId}/scenarios/db-c64.toml\nid = "db-c64"\ntitle = "Single query, 64 connections"\nkind = "http"\norder = 95\npath = "/db"\nconnections = 64\nwork = { select = 1 }`,
  },
  {
    id: 'domain',
    icon: 'layers' as const,
    title: 'Add a domain',
    text: 'A whole new area such as databases or compute. Domains are discovered automatically, and this website creates their pages as soon as they have results.',
    guide: guide('adding-a-domain.md'),
    code: `cp -r domains/_example domains/databases\n${cli} check databases\n${cli} run databases --quick --passes 2`,
  },
];
---

<BaseLayout
  title="Contribute"
  description="Submit measurements from your own hardware, add implementations, scenarios or whole domains."
  section="contribute"
>
  <div class="container">
    <header class="page-head">
      <Breadcrumbs items={[{ label: 'Home', path: routes.home() }, { label: 'Contribute' }]} />
      <h1>Contribute</h1>
      <p class="lead">
        {project.name} is run by its contributors. Every implementation, benchmark domain and published measurement arrives
        as a pull request, and anyone can open one. Results from more machines make every comparison more useful.
      </p>
      <div class="head-links">
        <a class="btn btn-primary btn-sm" href="#submit">Submit a measurement <Icon name="arrowDown" /></a>
        <a class="btn btn-secondary btn-sm" href={repoUrl(project, 'CONTRIBUTING.md', 'blob')}><Icon name="book" /> Contributing guide</a>
        <a class="btn btn-ghost btn-sm" href={discussions}>Ideas and questions</a>
      </div>
    </header>

    <div class="contribute">
      <section id="submit" class="anchor" aria-labelledby="submit-title">
        <div class="card path submit">
          <div class="path-text submit-intro">
            <p class="eyebrow"><Icon name="server" /> Measure on your hardware</p>
            <h2 id="submit-title">Submit a measurement</h2>
            {
              install && (
                <ol class="steps">
                  <li>
                    Install the <code>{cmd}</code> command: pick your system. It needs git and Python 3.11 or newer, no root
                    or administrator rights, clones the repository (a normal git checkout) and adds a launcher. Run it again
                    to update.
                  </li>
                </ol>
              )
            }
          </div>
          {install && <InstallChooser project={project} id="submit-install" class="submit-install" />}
          <div class="path-text submit-steps">
            <ol class="steps" start={install ? 2 : 1}>
              <li>
                To measure, use Linux with rootful Docker and cgroup v2 and at least 4 physical cores{install ? '' : ', git and Python 3.11 or newer'}.
                Close other workloads; on a laptop use mains power.
              </li>
              <li>
                <code>doctor</code> checks the machine and <code>check</code> builds every implementation and runs the
                functional checks. Then run the whole suite: it takes several hours, so start it in <code>tmux</code> or
                with <code>nohup</code>.
              </li>
              <li>
                The run prints where it wrote the bundle:
                <code>results/{domainId}/&lt;machine-id&gt;/&lt;run-id&gt;.json</code> in the checkout. Open a pull request
                from that checkout that adds only this file.
              </li>
            </ol>
            <a class="path-link" href={guide('submitting-results.md')}>
              Read the full guide <Icon name="arrowUpRight" size={14} />
            </a>
          </div>
          <CodeBlock code={submitCode} class="submit-code" />
        </div>

        <div class="grid grid-3 submit-facts">
          <div class="card card-pad">
            <h3><Icon name="pullRequest" class="inline-icon" /> What the pull request contains</h3>
            <p>
              Only the bundle file: no changes to code, manifests, <code>results/reference-runs.toml</code> or the generated
              website data. The bundle records the commit that was measured and contains no hostnames, user names or IP
              addresses. Quick smoke-test runs are never published.
            </p>
          </div>
          <div class="card card-pad">
            <h3><Icon name="checkCircle" class="inline-icon" /> How it is reviewed</h3>
            <p>
              CI re-verifies that the summary matches the per-pass data and that every scenario and metric is known.
              Maintainers then look for implausible values compared with similar hardware, many quality flags and options
              that differ from a full run.
            </p>
          </div>
          <div class="card card-pad">
            <h3><Icon name="shield" class="inline-icon" /> Reference and community</h3>
            <p>
              Merged runs are labelled <strong>community</strong>. <strong>Reference</strong> runs are the ones maintainers
              measured themselves and listed in
              <a href={repoUrl(project, 'results/reference-runs.toml', 'blob')}>results/reference-runs.toml</a>. Both are
              shown with their machine.
            </p>
            <p class="status">
              {plural(community.reference, 'reference run')} published. {communityRunsNote(community)}
            </p>
          </div>
        </div>
      </section>

      <section class="add" aria-labelledby="add-title">
        <h2 id="add-title">Add to the suite</h2>
        <p class="add-lead">
          These change the repository: fork it, clone your fork and run <code>{cli}</code> from the checkout.
        </p>
        <div class="paths">
          {
            paths.map((p) => (
              <article class="card path anchor" id={p.id}>
                <div class="path-text">
                  <h3>
                    <Icon name={p.icon} size={18} /> {p.title}
                  </h3>
                  <p>{p.text}</p>
                  <a class="path-link" href={p.guide}>
                    Read the guide <Icon name="arrowUpRight" size={14} />
                  </a>
                </div>
                <CodeBlock code={p.code} />
              </article>
            ))
          }
        </div>
      </section>

      <section class="rules" aria-labelledby="rules-title">
        <h2 id="rules-title">Rules for implementations</h2>
        <div class="grid grid-3">
          <div class="card card-pad">
            <h3>Idiomatic and production-like</h3>
            <p>Use the framework the way its documentation recommends for production. No response caching, precomputed responses, disabled validation or skipped database work.</p>
          </div>
          <div class="card card-pad">
            <h3>Same work, pinned versions</h3>
            <p>Pass the functional checks. Use exact image tags, exact dependency versions and committed lockfiles, and declare the versions in impl.toml.</p>
          </div>
          <div class="card card-pad">
            <h3>Honest category and configuration</h3>
            <p>Declare bare, micro, framework or full-stack truthfully, size workers for the CPU limit and document it in the notes.</p>
          </div>
        </div>
      </section>

      <section class="more" aria-labelledby="more-title">
        <h2 id="more-title">Other ways to help</h2>
        <ul class="more-list">
          <li>
            <Icon name="alert" />
            <div>
              <strong>Report unfairness or a measurement error.</strong> Open a <em>methodology</em> issue with evidence;
              methodology problems are discussed in public. <a href={issues}>Issues</a>
            </div>
          </li>
          <li>
            <Icon name="users" />
            <div>
              <strong>Share an idea or ask a question.</strong> Use <a href={discussions}>Discussions</a>; issues are for bugs
              and concrete proposals.
            </div>
          </li>
          <li>
            <Icon name="zap" />
            <div>
              <strong>Improve an existing implementation.</strong> Open a pull request that touches only its directory and
              mention the maintainers listed in its impl.toml.
            </div>
          </li>
          <li>
            <Icon name="layers" />
            <div>
              <strong>Improve the engine or this website.</strong> Open an issue first for larger changes. Changes to the
              engine, the harnesses and the list of reference runs are reviewed by the maintainers. The website lives in
              <a href={repoUrl(project, 'site', 'tree')}><code>site/</code></a> and is generated from the published dataset.
            </div>
          </li>
          <li>
            <Icon name="book" />
            <div>
              <strong>Understand the design.</strong> Read the <a href={repoUrl(project, 'docs/architecture.md', 'blob')}>architecture</a>
              and the <a href={href(routes.methodology())}>methodology</a>.
            </div>
          </li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>


<style>
  .head-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .contribute {
    display: grid;
    gap: 64px;
    padding-bottom: clamp(48px, 6vw, 88px);
  }
  .anchor {
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .paths {
    display: grid;
    gap: 14px;
  }
  .path {
    display: grid;
    gap: 20px;
    padding: clamp(18px, 2.4vw, 28px);
  }
  @media (min-width: 900px) {
    .path {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 40px;
      align-items: center;
    }
  }
  .path-text {
    min-width: 0;
  }
  .path h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.25rem;
  }
  .path-text > p {
    margin-top: 8px;
    color: var(--text-2);
  }
  .submit {
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
  }
  .submit h2 {
    font-size: 1.5rem;
  }
  .steps {
    display: grid;
    gap: 8px;
    margin: 14px 0 0;
    padding-left: 1.25em;
    color: var(--text-2);
  }
  .steps li::marker {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .path-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 14px;
    font-weight: 500;
    font-size: 0.9375rem;
  }
  /* Install first, also on narrow screens: intro and chooser, then the remaining steps and their commands. */
  @media (min-width: 900px) {
    .submit {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      grid-template-areas:
        'intro install'
        'steps code';
      row-gap: 28px;
      align-items: start;
    }
    .submit-intro {
      grid-area: intro;
    }
    .submit :global(.submit-install) {
      grid-area: install;
    }
    .submit-steps {
      grid-area: steps;
    }
    .submit :global(.submit-code) {
      grid-area: code;
    }
  }
  .submit-steps .steps {
    margin-top: 0;
  }
  .submit-facts {
    margin-top: 14px;
  }
  .submit-facts h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
  }
  .submit-facts p {
    margin-top: 8px;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .submit-facts strong {
    color: var(--text);
    font-weight: 600;
  }
  .submit-facts .status {
    padding-top: 10px;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--text);
  }
  .add h2,
  .rules h2,
  .more h2 {
    margin-bottom: 18px;
  }
  .add-lead {
    max-width: 70ch;
    margin: -8px 0 18px;
    color: var(--text-2);
  }
  .rules p {
    margin-top: 6px;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .more-list {
    display: grid;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 820px;
  }
  .more-list li {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-2);
  }
  .more-list li > :global(svg) {
    flex: none;
    margin-top: 4px;
    color: var(--muted);
  }
  .more-list strong {
    color: var(--text);
  }
</style>
