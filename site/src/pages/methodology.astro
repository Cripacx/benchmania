---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CpuLayout from '../components/CpuLayout.astro';
import Icon from '../components/Icon.astro';
import { allDomains, getProject } from '../lib/dataset';
import { betterText, plural } from '../lib/format';
import { domainMethodologies } from '../lib/methodology';
import {
  defaultRun,
  derivedExplanation,
  domainStatus,
  groupLabel,
  machineName,
  metricGroups,
  metricOrFallback,
  repoUrl,
  scenarioKindLabel,
  scenarioParams,
  sortScenarios,
} from '../lib/model';
import { href, routes } from '../lib/paths';

const project = getProject();
const domains = allDomains();
const several = domains.length > 1;

const toc = [
  { id: 'goals', label: 'Goals' },
  { id: 'environment', label: 'Environment and limits' },
  { id: 'layout', label: 'CPU layout' },
  { id: 'scenarios', label: 'Scenarios' },
  { id: 'metrics', label: 'Metrics' },
  { id: 'statistics', label: 'Statistics' },
  { id: 'quality', label: 'Quality controls' },
  { id: 'machines', label: 'Machines and provenance' },
  { id: 'versions', label: 'Methodology versions' },
  { id: 'limitations', label: 'Limitations' },
];

const serviceText = (service: Record<string, unknown> | undefined) => {
  const out: Array<[string, string]> = [];
  if (!service) return out;
  if (typeof service.cpus === 'number') out.push(['CPU limit', `${service.cpus} cores`]);
  if (typeof service.memory === 'string')
    out.push(['Memory limit', service.memory.replace(/^(\d+)g$/i, '$1 GiB').replace(/^(\d+)m$/i, '$1 MiB')]);
  for (const [k, v] of Object.entries(service)) {
    if (k === 'cpus' || k === 'memory') continue;
    if (typeof v === 'string' || typeof v === 'number') out.push([k.replace(/_/g, ' '), String(v)]);
  }
  return out;
};

// The metric whose spread between passes is noted: the one behind each domain's first relative index (as the publisher does).
const spreadLabels = domains.flatMap((d) => {
  const index = (d.derived ?? []).find((x) => x.kind === 'geomean_relative');
  return index ? [metricOrFallback(d.metrics, index.metric).label.toLowerCase()] : [];
});
const spreadText = [...new Set(spreadLabels)].join(' or ');
const indexDomains = domains.filter((d) => (d.derived ?? []).some((x) => x.kind === 'geomean_relative'));
---

<BaseLayout
  title="Methodology"
  description={`How results are produced, summarized and checked in ${plural(domains.length, 'benchmark domain')}, and how to read them.`}
  section="methodology"
>
  <div class="container">
    <header class="page-head">
      <Breadcrumbs items={[{ label: 'Home', path: routes.home() }, { label: 'Methodology' }]} />
      <h1>Methodology</h1>
      <p class="lead">
        How every number on this site is produced, summarized and checked. The engine's rules hold for every domain; what a
        domain measures and checks comes from that domain and is marked with its name. Each domain's full reference lives
        in the repository.
      </p>
      <div class="head-links">
        {
          domains.map((d) =>
            d.domain.methodology?.document ? (
              <a class="btn btn-secondary btn-sm" href={repoUrl(project, d.domain.methodology.document, 'blob')}>
                <Icon name="book" /> {several ? `Methodology: ${d.domain.title}` : 'Methodology document'}
              </a>
            ) : null,
          )
        }
        <a class="btn btn-ghost btn-sm" href={repoUrl(project, 'docs/architecture.md', 'blob')}>
          <Icon name="layers" /> Architecture
        </a>
      </div>
    </header>

    <div class="doc">
      <nav class="toc" aria-label="On this page">
        <p class="toc-title">On this page</p>
        <ol>
          {toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}
        </ol>
      </nav>

      <div class="doc-body">
        <section id="goals" class="doc-section">
          <h2>Goals</h2>
          <ol class="goals">
            <li>
              <strong>The same realistic workload for everyone.</strong> Within a domain every implementation gets the same
              workload and the same inputs, shaped after real use, under the same resource limits. What is verified about the
              work it does is up to the domain (its correctness checks, below).
            </li>
            <li>
              <strong>Verified, not assumed.</strong> Every implementation passes the domain's correctness checks before it is
              measured, and what it does during a measurement is checked as well.
            </li>
            <li>
              <strong>Transparent and reproducible.</strong> Every number comes with the machine, the exact versions, the
              configuration and the per-pass raw values.
            </li>
            <li>
              <strong>Honest uncertainty.</strong> Medians with confidence intervals, and quality flags instead of silent
              filtering.
            </li>
          </ol>
        </section>

        <section id="environment" class="doc-section">
          <h2>Environment and resource limits</h2>
          <p>
            Each implementation runs alone in its own container with fixed CPU and memory limits, pinned to the CPUs the
            layout assigns it. What else a domain needs runs next to it: supporting services such as a database in their own
            containers, the load generator and the benchmark runner as processes. Each is pinned to the CPUs of its role, and
            when the machine has enough CPUs the layout keeps those apart from the implementation's (<a href="#layout">CPU
            layout</a>, including what pinning does not control). What the limits are and what runs next to the
            implementation is up to the domain:
          </p>
          {
            domains.map((d) => {
              const status = domainStatus(d.domain.status);
              return (
                <div class="card card-pad env-card" id={`domain-${d.domain.id}`}>
                  <h3>
                    {d.domain.title}
                    {status && <span class="badge badge-warning env-status" title={status.description}>{status.label}</span>}
                  </h3>
                  {d.domain.description && <p class="text-2">{d.domain.description}</p>}
                  <dl class="env-stats">
                    {serviceText(d.domain.service).map(([k, v]) => (
                      <div>
                        <dt>{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                    <div>
                      <dt>Scenarios</dt>
                      <dd>{d.scenarios.length}</dd>
                    </div>
                    <div>
                      <dt>Metrics</dt>
                      <dd>{Object.keys(d.metrics).length}</dd>
                    </div>
                  </dl>
                  {d.domain.methodology?.document && (
                    <p class="env-doc">
                      <a href={repoUrl(project, d.domain.methodology.document, 'blob')}>
                        Full methodology: {d.domain.title} <Icon name="arrowRight" class="inline-icon" />
                      </a>
                    </p>
                  )}
                </div>
              );
            })
          }
        </section>

        <section id="layout" class="doc-section">
          <h2>CPU layout</h2>
          <p>
            The layout is computed from the CPUs the operating system reports at the start of every run and stored with the
            results. It assigns CPUs to roles; containers are pinned to their role's CPUs with a Docker cpuset, the load
            generator and the runner as processes (CPU affinity):
          </p>
          <ol>
            <li>
              The implementation under test gets one logical CPU per physical core for as many cores as its CPU limit. The
              benchmark assigns the SMT siblings of those cores to no role.
            </li>
            <li>
              The remaining physical cores are split between the environment (supporting services such as a database) and the
              load generator, which gets the larger half because it must never be the bottleneck. The benchmark runner itself
              is pinned to the load generator's CPUs (process affinity), also in a domain without a load generator; CPUs of a
              role a domain does not use are assigned to nothing.
            </li>
            <li>
              On a machine with too few physical cores the implementation gets logical CPUs whose SMT siblings can belong to
              other roles; with fewer CPUs than roles, all roles share all CPUs. Either way the run carries a warning in its
              quality flags. A layout given by hand is marked as such.
            </li>
          </ol>
          <p>
            <strong>What the layout does not control.</strong> Pinning decides which CPUs the benchmark's own containers and
            processes run on; it does not reserve them. Other processes on the machine, kernel threads and interrupts can
            still run on the same CPUs, and a CPU the layout does not assign is simply not used by the benchmark, not kept
            idle. On a virtual machine the CPUs are virtual: which physical cores run them, whether two of them share a core
            and what other guests run on the host is decided by the hypervisor and unknown to the benchmark. Runs on a virtual
            machine are marked next to their numbers.
          </p>
          {
            domains.map((d) => {
              const run = defaultRun(d);
              return run ? (
                <figure class="card card-pad layout-card">
                  <CpuLayout layout={run.layout} machine={d.machines[run.machine]} roleNames={d.domain.methodology?.roles} />
                  <figcaption class="muted">
                    {d.domain.title}, default run on {machineName(d.machines[run.machine], run.machine)}.
                  </figcaption>
                </figure>
              ) : null;
            })
          }
        </section>

        <section id="scenarios" class="doc-section">
          <h2>Scenarios</h2>
          <p>
            Scenarios are declared as files in the repository, and the domain's harness runs each one according to its kind.
            The lists below come straight from the dataset.
          </p>
          {
            domains.map((d) => (
              <div class="table-wrap scen-table" tabindex="0" role="region" aria-label={`${d.domain.title} scenarios`}>
                <table class="data">
                  <caption>{d.domain.title}</caption>
                  <thead>
                    <tr>
                      <th scope="col">Scenario</th>
                      <th scope="col">Kind</th>
                      <th scope="col">What it does</th>
                    </tr>
                  </thead>
                  <tbody>
                    {sortScenarios(d.scenarios).map((s) => (
                      <tr>
                        <th scope="row">
                          {s.title}
                          <span class="mono id">{s.id}</span>
                        </th>
                        <td class="nowrap">{scenarioKindLabel(s.kind)}</td>
                        <td>
                          {s.description}
                          {scenarioParams(s, d.scenarios).length > 0 && (
                            <span class="params">
                              {scenarioParams(s, d.scenarios).map((p) => (
                                <span class="tag">{p}</span>
                              ))}
                            </span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))
          }
        </section>

        <section id="metrics" class="doc-section">
          <h2>Metrics</h2>
          <p>
            Each domain has a metric registry that defines every value an implementation can be measured on: label, unit,
            which direction is better and how prominently the site shows it. <span class="badge">primary</span> metrics are
            shown first, <span class="badge">secondary</span> ones on request and <span class="badge">diagnostic</span> ones
            mainly explain measurement quality.
          </p>
          {
            domains.map((d) => (
              <>
                {several && <h3>{d.domain.title}</h3>}
                {metricGroups(d).map(({ group, metrics }) => (
                  <details class="metric-group" open={metrics.some((m) => m.visibility === 'primary')}>
                    <summary>
                      <span>{groupLabel(group)}</span>
                      <span class="muted">{plural(metrics.length, 'metric')}</span>
                    </summary>
                    <dl class="metric-list">
                      {metrics.map((m) => (
                        <div class="metric-item" id={`metric-${d.domain.id}-${m.id}`}>
                          <dt>
                            <span class="m-label">{m.label}</span>
                            <span class="m-meta">
                              {m.unit && <span class="tag">{m.unit}</span>}
                              <span class={`badge ${m.visibility === 'primary' ? 'badge-info' : 'badge-outline'}`}>
                                {m.visibility ?? 'secondary'}
                              </span>
                            </span>
                          </dt>
                          <dd>
                            <span class="dir">
                              {m.better === 'higher' && <Icon name="arrowUp" size={12} strokeWidth={2} />}
                              {m.better === 'lower' && <Icon name="arrowDown" size={12} strokeWidth={2} />}
                              {betterText(m.better)}
                            </span>
                            {m.description && <p>{m.description}</p>}
                            {derivedExplanation(d, m.id) && (
                              <p class="m-derived">
                                <strong>Computed:</strong> {derivedExplanation(d, m.id)}
                              </p>
                            )}
                            <code class="m-id">{m.id}</code>
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </details>
                ))}
              </>
            ))
          }
        </section>

        <section id="statistics" class="doc-section">
          <h2>Statistics</h2>
          <div class="stat-grid">
            <div class="card card-pad">
              <h3>Median of passes</h3>
              <p>
                A run repeats every measurement in several passes (five by default). Each metric is summarized by its median,
                which a single disturbed pass cannot move far.
              </p>
            </div>
            <div class="card card-pad">
              <h3>95 % bootstrap interval</h3>
              <p>
                The uncertainty of the median is a percentile bootstrap interval with 2,000 resamples and a fixed seed, so
                summaries are reproducible. With five passes it is the range from the lowest to the highest pass, which covers the
                true median with 93.75 % probability. With fewer than five passes there is no interval, and the site says so.
              </p>
            </div>
            <div class="card card-pad">
              <h3>Outliers and spread are flagged</h3>
              <p>
                A pass whose value has a robust z-score above 3.5 (based on the median absolute deviation) is marked, never
                silently removed.{spreadText && ` When the ${spreadText} behind a domain's index varies more than 10 % between passes, the value carries a note.`}
              </p>
            </div>
            <div class="card card-pad">
              <h3>Changing order</h3>
              <p>
                The order of implementations changes every pass (a shifted Williams design), so each one runs at a different
                position and after a different implementation each time. What one leaves behind, such as heat or cache
                contents, does not always hit the same successor.
              </p>
            </div>
          </div>
          <p class="note">
            Derived metrics such as an index are computed from the medians of one run, so they carry no interval of their own.
            Rankings count implementations with equal values as tied.
          </p>
        </section>

        <section id="quality" class="doc-section">
          <h2>Quality controls</h2>
          <p>In every domain:</p>
          <div class="table-wrap" tabindex="0" role="region" aria-label="Quality controls in every domain">
            <table class="data">
              <thead>
                <tr>
                  <th scope="col">Check</th>
                  <th scope="col">Effect</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">The domain's correctness checks fail before measuring (see below)</th>
                  <td>Implementation is excluded from the run</td>
                </tr>
                <tr>
                  <th scope="row">The measurement of an implementation fails in a pass</th>
                  <td>Flagged as an error; that pass is missing from the number of passes (n) behind its values</td>
                </tr>
                {
                  indexDomains.length > 0 && (
                    <tr>
                      <th scope="row">A missing or invalid result in one of the scenarios behind an index</th>
                      <td>No index for that implementation; its scenario results stay visible</td>
                    </tr>
                  )
                }
                <tr>
                  <th scope="row">Hypervisor steal time above the project's limit (2 % by default) during a measurement</th>
                  <td>Measurement repeated where the domain's harness can (up to twice by default), then flagged</td>
                </tr>
                <tr>
                  <th scope="row">A result bundle's summary does not match its per-pass data, or the bundle is filed under the wrong domain, machine or run id</th>
                  <td>Rejected by CI; published numbers are always recomputed from the per-pass values</td>
                </tr>
              </tbody>
            </table>
          </div>
          {
            domains
              .filter((d) => (d.domain.methodology?.checks ?? []).length > 0)
              .map((d) => (
                <div class="table-wrap" tabindex="0" role="region" aria-label={`Quality controls: ${d.domain.title}`}>
                  <table class="data">
                    <caption>{d.domain.title}</caption>
                    <thead>
                      <tr>
                        <th scope="col">Check</th>
                        <th scope="col">Effect</th>
                      </tr>
                    </thead>
                    <tbody>
                      {(d.domain.methodology?.checks ?? []).map((c) => (
                        <tr>
                          <th scope="row">{c.check}</th>
                          <td>{c.effect}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ))
          }
          <p class="note">
            Flags appear next to the affected value in the explorer, on implementation pages and on the run page.
          </p>
        </section>

        <section id="machines" class="doc-section">
          <h2>Machines and provenance</h2>
          <p>
            Absolute numbers depend heavily on the CPU, so the primary comparison is always <strong>within one run</strong>.
            Across machines, relative indices are more meaningful. Every run stores the machine fingerprint (CPU model, cores,
            SMT, governor, turbo, memory, kernel, OS, virtualization, Docker version) and the CPU layout. Shared cloud machines
            vary far more from pass to pass than dedicated hardware; the site says so next to their results.
            <a href={href(routes.machines())}>See all machines.</a>
          </p>
          <div class="grid grid-2 prov">
            <div class="card card-pad">
              <h3><Icon name="shield" class="inline-icon" /> Reference</h3>
              <p>
                Measured by the maintainers themselves, who list the run id in the repository. The machine alone does not
                decide it: every machine of the same model has the same id. The default view prefers complete reference runs.
              </p>
            </div>
            <div class="card card-pad">
              <h3><Icon name="users" class="inline-icon" /> Community</h3>
              <p>
                Submitted by anyone as a pull request containing a result bundle. CI verifies the bundle; maintainers look for
                implausible values. <a href={href(routes.contribute('submit'))}>Submit a run.</a>
              </p>
            </div>
          </div>
        </section>

        <section id="versions" class="doc-section">
          <h2>Methodology versions</h2>
          <p>
            Every run records the methodology version of its domain; versions are numbered per domain. Older versions stay
            visible, clearly labelled.
          </p>
          {
            domains.map((d) => (
              <>
                {several && <h3>{d.domain.title}</h3>}
                <div class="versions">
                  {domainMethodologies(d.domain, d.runs.map((r) => r.methodology)).map((v) => {
                    const runs = d.runs.filter((r) => (r.methodology ?? '') === v.version).length;
                    return (
                      <div class="card card-pad version">
                        <div class="version-head">
                          <h4>{v.label}</h4>
                          {v.preliminary ? (
                            <span class="badge badge-warning">
                              <Icon name="alert" /> Preliminary
                            </span>
                          ) : (
                            <span class="badge badge-outline">{runs > 0 ? 'In use' : 'Described'}</span>
                          )}
                        </div>
                        <p>{v.summary ?? 'The domain does not describe this version yet; see its methodology document.'}</p>
                        <p class="muted small">{plural(runs, 'published run')} with this version.</p>
                      </div>
                    );
                  })}
                </div>
              </>
            ))
          }
        </section>

        <section id="limitations" class="doc-section">
          <h2>Limitations</h2>
          <ul>
            <li>Workloads are a sample. They are shaped after real use but cannot represent every application.</li>
            <li>
              Implementations are configured to be idiomatic, and configuration choices matter. They are documented on each
              implementation page; better configurations are welcome as pull requests.
            </li>
          </ul>
          {
            domains
              .filter((d) => (d.domain.methodology?.limitations ?? []).length > 0)
              .map((d) => (
                <>
                  <h3>{d.domain.title}</h3>
                  <ul>
                    {(d.domain.methodology?.limitations ?? []).map((l) => (
                      <li>{l}</li>
                    ))}
                  </ul>
                </>
              ))
          }
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .head-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .doc {
    display: grid;
    gap: 32px;
    padding-bottom: clamp(48px, 6vw, 88px);
  }
  @media (min-width: 1024px) {
    .doc {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 56px;
    }
    .toc {
      position: sticky;
      top: calc(var(--header-h) + 24px);
      align-self: start;
    }
  }
  .toc {
    font-size: 0.875rem;
  }
  .toc-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
  }
  @media (min-width: 1024px) {
    .toc ol {
      display: grid;
      gap: 2px;
      border-left: 1px solid var(--border);
    }
    .toc a {
      display: block;
      padding: 4px 0 4px 14px;
      margin-left: -1px;
      border-left: 1px solid transparent;
    }
    .toc a:hover {
      border-left-color: var(--text);
    }
  }
  .toc a {
    color: var(--text-2);
  }
  .toc a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .doc-body {
    min-width: 0;
    max-width: 880px;
  }
  .doc-section + .doc-section {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }
  .doc-section > h2 {
    margin-bottom: 14px;
  }
  .doc-section > p,
  .doc-section > ol,
  .doc-section > ul {
    color: var(--text-2);
    max-width: 75ch;
  }
  .doc-section > ol,
  .doc-section > ul {
    padding-left: 1.2em;
  }
  .doc-section li + li {
    margin-top: 8px;
  }
  .doc-section > * + * {
    margin-top: 16px;
  }
  .goals strong {
    color: var(--text);
  }
  .env-status {
    margin-left: 8px;
    vertical-align: middle;
  }
  .env-doc {
    margin-top: 12px;
    font-size: 0.875rem;
  }
  .doc-section > h3 {
    margin-top: 28px;
  }
  .version-head h4 {
    font-size: 1rem;
  }
  .env-card h3 {
    margin-bottom: 8px;
  }
  .env-card p {
    font-size: 0.9375rem;
  }
  .env-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 12px;
    margin: 18px 0 0;
  }
  .env-stats div {
    padding: 12px 14px;
    border-radius: var(--radius);
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .env-stats dt {
    font-size: 0.75rem;
    color: var(--muted);
    text-transform: capitalize;
  }
  .env-stats dd {
    margin: 2px 0 0;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .layout-card {
    margin-inline: 0;
  }
  .layout-card > figcaption {
    margin-top: 14px;
    font-size: 0.8125rem;
  }
  .scen-table th[scope='row'] {
    min-width: 150px;
  }
  /* Phones: one block per scenario (title and kind, the description below), nothing cut off at the right edge. */
  @media (max-width: 599px) {
    .scen-table table,
    .scen-table tbody,
    .scen-table tr,
    .scen-table caption {
      display: block;
    }
    .scen-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .scen-table tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 12px;
      padding: 12px 14px;
      border-bottom: 1px solid var(--border);
    }
    .scen-table tr:last-child {
      border-bottom: 0;
    }
    .scen-table caption {
      padding: 10px 14px 0;
    }
    .scen-table td.nowrap {
      font-size: 0.8125rem;
      color: var(--muted);
    }
    .scen-table th[scope='row'],
    .scen-table td {
      display: block;
      min-width: 0;
      padding: 0;
      border: 0;
      white-space: normal;
    }
    .scen-table td:last-child {
      grid-column: 1 / -1;
    }
  }
  .id {
