---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import CpuLayout from '../../../../components/CpuLayout.astro';
import ExplorerPage from '../../../../components/ExplorerPage.astro';
import Icon from '../../../../components/Icon.astro';
import RunBadges from '../../../../components/RunBadges.astro';
import RunNotice from '../../../../components/RunNotice.astro';
import RunScopeNotice from '../../../../components/RunScopeNotice.astro';
import { allDomains, getProject } from '../../../../lib/dataset';
import { formatBytes, formatDate, formatDateTime, formatDuration, isNum, plural } from '../../../../lib/format';
import { methodologyInfo } from '../../../../lib/methodology';
import {
  bundleUrl,
  defaultRun,
  flagImplementation,
  flagScenario,
  implementation,
  machineName,
  provenanceInfo,
  runImplementationIds,
} from '../../../../lib/model';
import { href, routes } from '../../../../lib/paths';
import type { DomainData, Run } from '../../../../lib/types';

export function getStaticPaths() {
  return allDomains().flatMap((domain) =>
    domain.runs.map((run) => ({ params: { domain: domain.domain.id, run: run.id }, props: { domain, run } })),
  );
}

interface Props {
  domain: DomainData;
  run: Run;
}

const { domain, run } = Astro.props;
const project = getProject();
const machine = domain.machines[run.machine];
const method = methodologyInfo(run.methodology);
const prov = provenanceInfo(run.provenance);
const ids = runImplementationIds(domain, run);
// Links follow the route: this page and everything it links to stays on this run, also when it is the default.
const scope = run.id;
const isDefault = run.id === defaultRun(domain)?.id;
const duration = formatDuration(run.created, run.finished);
const options = Object.entries(run.options ?? {}).filter(([k]) => k !== 'note');
const scenarioTitle = (id: string | null) => domain.scenarios.find((s) => s.id === id)?.title ?? id ?? '';
const flagsByImpl = new Map<string, typeof run.flags>();
for (const f of run.flags ?? []) {
  const key = flagImplementation(f) ?? 'run';
  flagsByImpl.set(key, [...(flagsByImpl.get(key) ?? []), f]);
}
const optionText = (v: unknown): string => {
  if (Array.isArray(v)) return v.join(', ');
  if (typeof v === 'boolean') return v ? 'yes' : 'no';
  if (v === null || v === undefined) return 'none';
  if (typeof v === 'object') return JSON.stringify(v);
  return String(v);
};
---

<BaseLayout
  title={`Run ${formatDate(run.created)} · ${domain.domain.title}`}
  description={`${domain.domain.title} run of ${formatDate(run.created)} on ${machineName(machine, run.machine)}.`}
  section={`domain:${domain.domain.id}`}
>
  <div class="container">
    <header class="page-head">
      <Breadcrumbs
        items={[
          { label: 'Home', path: routes.home() },
          { label: domain.domain.title },
          { label: 'Runs', path: routes.runs(domain.domain.id) },
          { label: formatDate(run.created) },
        ]}
      />
      <div class="run-title">
        <h1>Run of {formatDate(run.created)}</h1>
        {isDefault && <span class="badge">Default run</span>}
      </div>
      <p class="mono run-id">{run.id}</p>
      <div class="run-badges"><RunBadges run={run} /></div>
    </header>

    <div class="run-page">
      <RunScopeNotice domain={domain} run={run} defaultPath={routes.domain(domain.domain.id)} />
      <RunNotice domain={domain} run={run} />

      <div class="grid grid-3 run-cards">
        <section class="card card-pad">
          <h2 class="card-title">Run</h2>
          <dl class="kv">
            <dt>Started</dt>
            <dd>{formatDateTime(run.created)}</dd>
            <dt>Finished</dt>
            <dd>{formatDateTime(run.finished)}{duration && <span class="muted"> · {duration}</span>}</dd>
            <dt>Status</dt>
            <dd>{run.status ?? 'unknown'}</dd>
            <dt>Passes</dt>
            <dd>{run.passes}</dd>
            <dt>Provenance</dt>
            <dd title={prov.description}>{prov.label}</dd>
            <dt>Methodology</dt>
            <dd>{method.label}</dd>
            {run.tool?.engine_version && (
              <>
                <dt>Engine</dt>
                <dd class="mono small">{run.tool.engine_version}</dd>
              </>
            )}
            {typeof run.tool?.git === 'string' && (
              <>
                <dt>Commit</dt>
                <dd class="mono small">{run.tool.git}</dd>
              </>
            )}
          </dl>
        </section>

        <section class="card card-pad">
          <h2 class="card-title">Machine</h2>
          <dl class="kv">
            <dt>Name</dt>
            <dd><a href={href(routes.machine(run.machine))}>{machineName(machine, run.machine)}</a></dd>
            {machine?.cpu?.model && (
              <>
                <dt>CPU</dt>
                <dd>{machine.cpu.model}</dd>
              </>
            )}
            {isNum(machine?.memory_gib) && (
              <>
                <dt>Memory</dt>
                <dd>{machine.memory_gib} GiB</dd>
              </>
            )}
            {machine?.os?.name && (
              <>
                <dt>OS</dt>
                <dd>{machine.os.name}</dd>
              </>
            )}
            <dt>Fingerprint</dt>
            <dd class="mono small">{run.machine}</dd>
          </dl>
        </section>

        <section class="card card-pad">
          <h2 class="card-title">Options</h2>
          <dl class="kv">
            {options.map(([k, v]) => (
              <>
                <dt>{k.replace(/_/g, ' ')}</dt>
                <dd>{optionText(v)}</dd>
              </>
            ))}
          </dl>
          {run.options?.note && <p class="opt-note">{run.options.note}</p>}
        </section>
      </div>

      <section class="card card-pad">
        <div class="card-head">
          <h2 class="card-title">CPU layout</h2>
          <p class="muted">Which logical CPUs each role was pinned to during this run.</p>
        </div>
        <CpuLayout layout={run.layout} machine={machine} roleNames={domain.domain.methodology?.roles} />
      </section>

      <section aria-labelledby="impls-title">
        <div class="section-head">
          <div>
            <h2 id="impls-title">Implementations</h2>
            <p>{plural(ids.length, 'implementation')} with their build and check status as recorded in this run.</p>
          </div>
          <div class="head-actions">
            <a class="btn btn-secondary btn-sm" href={bundleUrl(project, domain.domain.id, run)}>
              <Icon name="file" /> Raw result bundle
            </a>
          </div>
        </div>
        <div class="table-wrap" tabindex="0" role="region" aria-label="Implementations in this run">
          <table class="data">
            <thead>
              <tr>
                <th scope="col">Implementation</th>
                <th scope="col">Functional check</th>
                <th scope="col" class="r">Image size</th>
                <th scope="col" class="r">Flags</th>
                <th scope="col">Note</th>
              </tr>
            </thead>
            <tbody>
              {ids.map((id) => {
                const impl = implementation(domain, id, run);
                const entry = run.implementations?.[id];
                const check = entry?.check;
                const ok = check === 'ok';
                return (
                  <tr>
                    <th scope="row">
                      <a href={href(routes.implementation(domain.domain.id, id, scope))}>{impl.name}</a>
                      {impl.variant && <span class="muted"> · {impl.variant}</span>}
                    </th>
                    <td class="nowrap">
                      <span class={`check ${ok ? 'ok' : 'bad'}`}>
                        <Icon name={ok ? 'checkCircle' : 'alert'} />
                        {ok ? 'passed' : check == null ? 'not recorded' : Array.isArray(check) ? check.join(', ') : check}
                      </span>
                    </td>
                    <td class="r nowrap">{isNum(entry?.image?.size_bytes) ? formatBytes(entry?.image?.size_bytes) : '—'}</td>
                    <td class="r">{(flagsByImpl.get(id) ?? []).length}</td>
                    <td class="muted small-cell">{entry?.manifest?.versions_note ?? ''}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <section aria-labelledby="flags-title">
        <div class="section-head">
          <div>
            <h2 id="flags-title">Quality flags</h2>
            <p>Warnings raised while measuring. Flagged results stay in the data and are marked wherever they appear.</p>
          </div>
        </div>
        {
          (run.flags ?? []).length === 0 ? (
            <p class="card card-pad empty">
              <Icon name="checkCircle" class="inline-icon" /> No quality flags were raised in this run.
            </p>
          ) : (
            <div class="grid grid-2">
              {[...flagsByImpl.entries()].map(([key, list]) => (
                <section class="card card-pad">
                  <h3 class="flag-head">
                    {key === 'run' ? 'Whole run' : implementation(domain, key, run).name}
                    {key !== 'run' && implementation(domain, key, run).variant && (
                      <span class="muted"> · {implementation(domain, key, run).variant}</span>
                    )}
                  </h3>
                  <ul class="flag-list">
                    {(list ?? []).map((f) => (
                      <li class={f.level === 'info' ? 'info' : ''}>
                        <Icon name={f.level === 'info' ? 'info' : 'alert'} />
                        <span>
                          {flagScenario(f) && <strong>{scenarioTitle(flagScenario(f))}: </strong>}
                          {f.message}
                          {f.pass ? ` (pass ${f.pass})` : ''}
                        </span>
                      </li>
                    ))}
                  </ul>
                </section>
              ))}
            </div>
          )
        }
      </section>

      <section aria-labelledby="results-title" class="run-results">
        <div class="section-head">
          <div>
            <h2 id="results-title">Results</h2>
            <p>
              Explore every scenario and metric of this run.
              {isDefault && (
                <>
                  {' '}This page stays on this run; <a href={href(routes.domain(domain.domain.id))} data-run-exit>the short explorer URL</a>{' '}
                  always shows the current default run.
                </>
              )}
            </p>
          </div>
        </div>
        <ExplorerPage domain={domain} run={run} showContext={false} scoped />
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .run-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }
  .run-id {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }
  .run-badges {
    margin-top: 14px;
  }
  .run-page {
    display: grid;
    gap: 40px;
    padding-bottom: clamp(48px, 6vw, 88px);
  }
  .run-cards .kv {
    font-size: 0.875rem;
  }
  .card-title {
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 14px;
  }
  .card-head {
    margin-bottom: 16px;
  }
  .card-head .card-title {
    margin-bottom: 2px;
  }
  .card-head p {
    font-size: 0.8125rem;
  }
  .small {
    font-size: 0.75rem;
  }
  .opt-note {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--text-2);
  }
  .small-cell {
    font-size: 0.75rem;
    min-width: 220px;
  }
  .check {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .check :global(svg) {
    width: 14px;
    height: 14px;
  }
  .check.ok :global(svg) {
    color: var(--good-icon);
  }
  .check.bad {
    color: var(--warn-text);
  }
  .check.bad :global(svg) {
    color: var(--warn-icon);
  }
  .flag-head {
    font-size: 0.9375rem;
    margin-bottom: 12px;
  }
  .head-actions {
    display: flex;
    gap: 8px;
  }
</style>
